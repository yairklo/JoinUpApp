# Names only. Set these in Vercel (and in a local .env, which is gitignored).
# Never commit values. Never put production Clerk keys on Preview or Development.

# Production (Vercel → Production) — leave as they are today:
#   NEXT_PUBLIC_API_URL=https://joinup-api.duckdns.org
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
#   CLERK_SECRET_KEY=sk_live_...

# Preview and Development — point at the Coolify dev API and the Clerk dev instance:
#   NEXT_PUBLIC_API_URL=https://joinup-dev-api.duckdns.org
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
#   CLERK_SECRET_KEY=sk_test_...
# Do NOT set NEXT_PUBLIC_CLERK_PROXY_URL on Preview or Development (or in .env.local
# when the key is pk_test_). That variable is the production /__clerk proxy.
# resolveClerkProxyUrl() ignores it for pk_test_ keys; leave it unset anyway.

NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# NEXT_PUBLIC_* is baked in at build time. After changing Preview values, redeploy the preview.
# Local: cd next_app && npm run dev
