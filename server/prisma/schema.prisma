generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                        String                     @id
  email                     String?                    @unique
  name                      String?
  imageUrl                  String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  city                      String?
  phone                     String?
  birthDate                 DateTime?
  /// Optional binary gender for profile display (MALE = גבר, FEMALE = אישה)
  gender                    Gender?
  reputation                Int                        @default(50)
  privacyFriends            PrivacyLevel?
  privacyGames              PrivacyLevel?
  privacyMessages           PrivacyLevel?
  /// When true, the user's series (group) memberships are hidden from other viewers' view of their profile.
  hideGroups                Boolean                    @default(false)
  /// Global block from commenting/reporting on fields (narrower than a full account ban).
  blockedFromFieldSocial    Boolean                    @default(false)
  chatParticipations        ChatParticipant[]
  favoriteFields            FavoriteField[]
  fieldComments             FieldComment[]
  fieldCommentReactions     FieldCommentReaction[]
  fieldCommentFlags         FieldCommentFlag[]
  fieldIssueReports         FieldIssueReport[]
  fieldIssueReportReactions FieldIssueReportReaction[]
  fieldIssueReportFlags     FieldIssueReportFlag[]
  supportMessages           SupportMessage[]
  fieldSuggestions          FieldSuggestion[]
  requestsRecv              FriendRequest[]            @relation("Recv")
  requestsSent              FriendRequest[]            @relation("Sent")
  friendshipsA              Friendship[]               @relation("A")
  friendshipsB              Friendship[]               @relation("B")
  organizedGames            Game[]                     @relation("OrganizerGames")
  organizedSeries           GameSeries[]               @relation("OrganizerSeries")
  gameRoles                 GameRole[]
  messages                  Message[]
  notifications             Notification[]             @relation("UserNotifications")
  participations            Participation[]
  seriesSubscriptions       SeriesParticipant[]
  seriesJoinRequests        SeriesJoinRequest[]
  devices                   UserDevice[]               @relation("UserDevices")
  notificationSettings      UserNotificationSettings?  @relation("UserNotificationSettings")
  notificationMutes         NotificationMute[]         @relation("UserNotificationMutes")
  positions                 UserPosition[]
  ratingsGiven              UserRating[]               @relation("RatingsGiven")
  ratingsReceived           UserRating[]               @relation("RatingsReceived")
  sports                    UserSport[]
  blocksGiven               UserBlock[]                @relation("BlocksGiven")
  blocksReceived            UserBlock[]                @relation("BlocksReceived")
  /// Set when the user deleted their own account: the row is kept as an anonymous tombstone so
  /// organised games / series / chat history keep valid references.
  deletedAt                 DateTime?
  /// Terms of Use + Privacy Policy acceptance (version = shared/ageGate.js LEGAL_VERSION).
  termsAcceptedAt           DateTime?
  termsVersion              String?
  /// Minor (13-17) declared guardian consent, recorded together with termsAcceptedAt.
  guardianConsentAt         DateTime?
  /// Opt-out: hide the player match-stats summary from other viewers of the profile.
  hideMatchStats            Boolean                    @default(false)
  playerStatEntries         PlayerStatEntry[]
  roundAppearances          GameResultRoundPlayer[]
  reportsFiled              UserReport[]               @relation("ReportsFiled")
  reportsReceived           UserReport[]               @relation("ReportsReceived")
  organizedTournaments      Tournament[]               @relation("TournamentOrganizer")
  tournamentRoles           TournamentRole[]
  tournamentMemberships     TournamentTeamMember[]
  captainedTournamentTeams  TournamentTeam[]           @relation("TournamentTeamCaptain")
  standingsOverridesCreated TournamentStandingsOverride[] @relation("StandingsOverrideCreatedBy")
  standingsOverridesUpdated TournamentStandingsOverride[] @relation("StandingsOverrideUpdatedBy")
}

/// One-directional user block (App Store UGC requirement): blocker no longer sees the blocked
/// user's content and the two can no longer start chats or send friend requests.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Field {
  id              String             @id @default(cuid())
  name            String
  location        String
  description     String?
  price           Int                @default(0)
  rating          Float              @default(0)
  image           String?
  available       Boolean            @default(true)
  type            FieldType
  lat             Float?
  lng             Float?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  city            String?
  email           String?
  featuresJson    Json?
  neighborhood    String?
  phone           String?
  photos          String[]
  street          String?
  streetNumber    String?
  supportedSports SportType[]        @default([SOCCER])
  favorites       FavoriteField[]
  reports         FieldReport[]
  comments        FieldComment[]
  issueReports    FieldIssueReport[]
  games           Game[]

  @@index([lat, lng])
  @@index([available, lat, lng])
  @@index([city])
  tournaments Tournament[]
}

enum ReactionType {
  LIKE
  DISLIKE
}

enum FieldFlagReason {
  OFFENSIVE
  FALSE_INFO
  SPAM
  OTHER
}

enum FieldFlagStatus {
  PENDING
  DISMISSED
}

/// Free-text comment left by a player on a field's profile page. `parentId` supports
/// one level of replies (a reply's own parentId must point at a top-level comment).
model FieldComment {
  id        String                 @id @default(cuid())
  fieldId   String
  userId    String
  parentId  String?
  text      String
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  field     Field                  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    FieldComment?          @relation("FieldCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   FieldComment[]         @relation("FieldCommentReplies")
  reactions FieldCommentReaction[]
  flags     FieldCommentFlag[]

  @@index([fieldId, createdAt])
  @@index([parentId])
}

/// A user flagging a FieldComment as offensive/false/spam for admin review
/// (server/routes/admin.js's field-comment-flags endpoints). Unique per
/// (commentId, reporterId) so re-reporting the same comment is a no-op upsert.
model FieldCommentFlag {
  id         String          @id @default(cuid())
  commentId  String
  reporterId String
  reason     FieldFlagReason
  details    String?
  status     FieldFlagStatus @default(PENDING)
  createdAt  DateTime        @default(now())
  comment    FieldComment    @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter   User            @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([commentId, reporterId])
  @@index([status])
}

/// One user's like/dislike on a FieldComment. Unique per (commentId, userId) so a
/// second reaction from the same user replaces (never adds to) their first.
model FieldCommentReaction {
  id        String       @id @default(cuid())
  commentId String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())
  comment   FieldComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

enum FieldIssueCategory {
  POTHOLE
  LIGHTING
  SURFACE
  GOAL_NET
  FENCE
  OTHER
}

enum FieldIssueStatus {
  OPEN
  RESOLVED
}

enum SupportMessageType {
  BUG
  FEEDBACK
}

enum SupportMessageStatus {
  OPEN
  RESOLVED
}

/// Player-reported physical defect at a field (pothole, broken lighting, etc.).
/// `parentId` supports one level of replies to a report; a reply has no `category`
/// (that's a top-level-report-only concept) and never changes `status`.
model FieldIssueReport {
  id          String                     @id @default(cuid())
  fieldId     String
  userId      String
  parentId    String?
  category    FieldIssueCategory?
  description String?
  photoUrl    String?
  status      FieldIssueStatus           @default(OPEN)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  resolvedAt  DateTime?
  field       Field                      @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      FieldIssueReport?          @relation("FieldIssueReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     FieldIssueReport[]         @relation("FieldIssueReplies")
  reactions   FieldIssueReportReaction[]
  flags       FieldIssueReportFlag[]

  @@index([fieldId, status])
  @@index([fieldId, createdAt])
  @@index([parentId])
}

/// A user flagging a FieldIssueReport as offensive/false/spam for admin review.
/// Unique per (issueId, reporterId) so re-reporting the same report is a no-op upsert.
model FieldIssueReportFlag {
  id         String           @id @default(cuid())
  issueId    String
  reporterId String
  reason     FieldFlagReason
  details    String?
  status     FieldFlagStatus  @default(PENDING)
  createdAt  DateTime         @default(now())
  issue      FieldIssueReport @relation(fields: [issueId], references: [id], onDelete: Cascade)
  reporter   User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([issueId, reporterId])
  @@index([status])
}

/// One user's like/dislike on a FieldIssueReport. Unique per (issueId, userId).
model FieldIssueReportReaction {
  id        String           @id @default(cuid())
  issueId   String
  userId    String
  type      ReactionType
  createdAt DateTime         @default(now())
  issue     FieldIssueReport @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
}

/// Crowdsourced crowd-level log submitted by players viewing a field.
/// dayOfWeek/hour are stored as Jerusalem-local values computed server-side at
/// write time (0 = Sunday, hour 0-23), so busy-profile aggregation is a plain
/// integer groupBy with no timezone math at read time. createdAt remains UTC.
model FieldReport {
  id        String   @id @default(cuid())
  fieldId   String
  /// Reporter — used for rate-limiting duplicate reports (nullable for legacy/anonymized rows)
  userId    String?
  dayOfWeek Int
  hour      Int
  /// 1=Empty, 2=Light, 3=Moderate, 4=Crowded, 5=Full (Int rather than enum so Prisma can _avg it)
  busyLevel Int
  createdAt DateTime @default(now())
  field     Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, dayOfWeek, hour])
  @@index([fieldId, userId, createdAt])
}

/// A user-submitted bug report or general message to the app team, surfaced
/// to admins under /admin (web) and /admin (mobile). Not tied to a specific
/// Field or Game -- this is app-wide feedback, unlike FieldIssueReport.
model SupportMessage {
  id         String               @id @default(cuid())
  userId     String
  type       SupportMessageType
  message    String
  /// Optional free-text context the client can attach (e.g. current screen/route,
  /// app version) to help debugging. Never required.
  context    String?
  status     SupportMessageStatus @default(OPEN)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  resolvedAt DateTime?
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// A user's request to add a venue to the public field list ("הצע מגרש חדש").
/// Never creates a Field on its own -- the venue stays out of search until an admin
/// approves it, which creates the real (available) Field and links it via createdFieldId.
/// Distinct from the inline `newField` on game creation, which makes an unlisted,
/// single-game location (ad-hoc meeting spot) and is intentionally not moderated.
model FieldSuggestion {
  id             String                @id @default(cuid())
  userId         String
  name           String
  address        String
  /// null = the suggester doesn't know
  isPaid         Boolean?
  contactInfo    String?
  lat            Float?
  lng            Float?
  sport          String?
  status         FieldSuggestionStatus @default(PENDING)
  createdFieldId String?
  adminNote      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  resolvedAt     DateTime?
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

enum FieldSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Game {
  id                   String            @id @default(cuid())
  fieldId              String
  start                DateTime
  duration             Float             @default(1)
  maxPlayers           Int
  isOpenToJoin         Boolean           @default(true)
  description          String?
  welcomeMessage       String?
  /// Members-vs-guests (see utils/membersGuests.js). Copied from the group; per-game overridable.
  membersOnlyPriority  Boolean           @default(false)
  /// Guests (non-members of the group) may join from this moment; members from registrationOpensAt.
  guestRegistrationOpensAt DateTime?
  guestWelcomeMessage  String?
  guestDescription     String?
  /// Display-only ILS amount shown to guests. Not billed in-app.
  guestPrice           Int?
  organizerId          String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  customLat            Float?
  customLng            Float?
  customLocation       String?
  isFriendsOnly        Boolean           @default(false)
  friendsOnlyUntil     DateTime?
  /// What a friends-only game's link does for people who aren't the organizer's friends (and
  /// aren't on the roster / series): REQUEST_TO_JOIN lets them view it but turns their join into
  /// a request the managers approve; BLOCKED hides it from them entirely. Ignored once the game
  /// is public (not friends-only, or friendsOnlyUntil has passed).
  friendsOnlyLinkPolicy FriendsOnlyLinkPolicy @default(REQUEST_TO_JOIN)
  lotteryAt            DateTime?
  lotteryEnabled       Boolean           @default(false)
  lotteryExecutedAt    DateTime?
  organizerInLottery   Boolean           @default(false)
  /// Optional reference to a recurring series
  seriesId             String?
  sport                SportType         @default(SOCCER)
  registrationOpensAt  DateTime?
  title                String?
  /// Optional cover photo for this game (Cloudinary URL). Cards fall back to the series image, then the field photo.
  imageUrl             String?
  teamSize             Int?
  /// Display-only ILS amount. Collected at the field or by the organizer — joinUp does not process payments.
  price                Int?
  status               GameStatus        @default(OPEN)
  reminderSent         Boolean           @default(false)
  joinPolicy           JoinPolicy        @default(INSTANT)
  pickDrawAt           DateTime?
  pickDrawExecutedAt   DateTime?
  pickingStartsAt      DateTime?
  pickingOpenedAt      DateTime?
  pickSessionStatus    PickSessionStatus @default(IDLE)
  pickTurnOrder        Json?
  pickCurrentTurnIndex Int               @default(0)
  pickOrderType        String            @default("CIRCULAR")
  managerPickChatId    String?
  field                Field             @relation(fields: [fieldId], references: [id])
  organizer            User              @relation("OrganizerGames", fields: [organizerId], references: [id])
  series               GameSeries?       @relation(fields: [seriesId], references: [id])
  roles                GameRole[]
  participants         Participation[]
  playerTrades         PlayerTrade[]
  teams                Team[]
  ratings              UserRating[]

  /// One occurrence per series slot — guards weekly generation against a second job process.
  @@unique([seriesId, start])
  result                  GameResult?
  statEntries             PlayerStatEntry[]

  @@index([start, status])
  @@index([status, start])
  @@index([sport])
  @@index([fieldId])
  @@index([organizerId])
  @@index([customLat, customLng])
  @@index([pickDrawAt, pickDrawExecutedAt])
  @@index([pickingStartsAt, pickingOpenedAt])
}

model Participation {
  id              String              @id @default(cuid())
  gameId          String
  userId          String
  createdAt       DateTime            @default(now())
  status          ParticipationStatus @default(CONFIRMED)
  teamId          String?
  isWaitlistOffer Boolean             @default(false)
  isCaptain       Boolean             @default(false)
  game            Game                @relation(fields: [gameId], references: [id])
  team            Team?               @relation(fields: [teamId], references: [id])
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([userId])
  @@index([gameId, status])
  @@index([teamId])
}

/// Per-match player rating (1–5 stars). One row per rater→target per game.
model UserRating {
  id        String   @id @default(cuid())
  gameId    String
  raterId   String
  targetId  String
  score     Int
  createdAt DateTime @default(now())
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  rater     User     @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  target    User     @relation("RatingsReceived", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([gameId, raterId, targetId])
  @@index([targetId])
  @@index([gameId, raterId])
}

model ChatRoom {
  id           String            @id @default(cuid())
  type         String            @default("PRIVATE")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  participants ChatParticipant[]
  messages     Message[]
}

model ChatParticipant {
  id         String    @id @default(cuid())
  userId     String
  chatId     String
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?
  chat       ChatRoom  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chatId])
}

model Message {
  id          String        @id @default(cuid())
  userId      String?
  text        String
  createdAt   DateTime      @default(now())
  replyToId   String?
  status      MessageStatus @default(sent)
  chatRoomId  String
  isDeleted   Boolean       @default(false)
  isEdited    Boolean       @default(false)
  /// Original text kept when the sender deletes a message (`text` is blanked). Never sent to
  /// clients; lets a late report and the admin queue still see what was written.
  deletedText String?
  deletedAt   DateTime?
  chatRoom    ChatRoom      @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  replyTo     Message?      @relation("ReplyTo", fields: [replyToId], references: [id])
  replies     Message[]     @relation("ReplyTo")
  user        User?         @relation(fields: [userId], references: [id])
  reactions   Reaction[]
  edits       MessageEdit[]

  @@index([chatRoomId])
  @@index([chatRoomId, createdAt])
  @@index([chatRoomId, status, userId])
}

/// One row per edit, holding the text as it was BEFORE the edit, so editing a message
/// cannot erase what was originally written (moderation evidence).
model MessageEdit {
  id           String   @id @default(cuid())
  messageId    String
  previousText String
  editedAt     DateTime @default(now())
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, editedAt])
}

model Reaction {
  id        String   @id @default(cuid())
  emoji     String
  userId    String
  messageId String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, emoji])
}

model FavoriteField {
  id      String @id @default(cuid())
  userId  String
  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id])
  user    User   @relation(fields: [userId], references: [id])

  @@unique([userId, fieldId])
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  userA     User     @relation("A", fields: [userAId], references: [id])
  userB     User     @relation("B", fields: [userBId], references: [id])

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model FriendRequest {
  id          String              @id @default(cuid())
  requesterId String
  receiverId  String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  receiver    User                @relation("Recv", fields: [receiverId], references: [id])
  requester   User                @relation("Sent", fields: [requesterId], references: [id])

  @@unique([requesterId, receiverId])
}

model Sport {
  id        String      @id @default(cuid())
  name      String      @unique
  positions Position[]
  users     UserSport[]
}

model Position {
  id      String         @id @default(cuid())
  name    String
  sportId String
  sport   Sport          @relation(fields: [sportId], references: [id])
  users   UserPosition[]

  @@unique([sportId, name])
}

model UserSport {
  id                  String  @id @default(cuid())
  userId              String
  sportId             String
  positionDescription String?
  sport               Sport   @relation(fields: [sportId], references: [id])
  user                User    @relation(fields: [userId], references: [id])

  @@unique([userId, sportId])
}

model UserPosition {
  id         String   @id @default(cuid())
  userId     String
  positionId String
  position   Position @relation(fields: [positionId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, positionId])
}

model GameRole {
  id        String       @id @default(cuid())
  gameId    String
  userId    String
  role      GameRoleType @default(MANAGER)
  createdAt DateTime     @default(now())
  game      Game         @relation(fields: [gameId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@unique([gameId, userId])
}

model Team {
  id        String          @id @default(cuid())
  gameId    String
  name      String
  color     String
  createdAt DateTime        @default(now())
  managerId String?
  players   Participation[]
  game      Game            @relation(fields: [gameId], references: [id])

  @@index([gameId])
  @@index([gameId, managerId])
}

/// Manager-only player swap proposals. Players are never notified.
model PlayerTrade {
  id                 String      @id @default(cuid())
  gameId             String
  proposerId         String
  receiverId         String
  offeredPlayerIds   String[]
  requestedPlayerIds String[]
  status             TradeStatus @default(PENDING)
  createdAt          DateTime    @default(now())
  resolvedAt         DateTime?
  game               Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, status])
  @@index([receiverId, status])
  @@index([proposerId])
}

model GameSeries {
  id                        String              @id @default(cuid())
  organizerId               String
  fieldId                   String?
  fieldName                 String
  fieldLocation             String
  /// Display-only ILS amount for generated games. Not billed in-app.
  price                     Int                 @default(0)
  maxPlayers                Int
  /// 0-6 (Sunday=0 per JS Date.getDay()) - only for WEEKLY
  dayOfWeek                 Int?
  /// "HH:MM"
  time                      String
  /// hours (can be fractional)
  duration                  Float
  isActive                  Boolean             @default(true)
  createdAt                 DateTime            @default(now())
  /// Recurrence type: weekly auto vs. custom dates
  type                      RecurrenceType      @default(WEEKLY)
  sport                     SportType           @default(SOCCER)
  autoOpenRegistrationHours Float?
  /// Fixed weekly registration-open rule for the group's games, in Asia/Jerusalem: each game's
  /// registration opens at the latest (registrationOpenDayOfWeek, registrationOpenTime) before it
  /// starts. 0-6, Sunday=0. Takes precedence over autoOpenRegistrationHours; the series PATCH
  /// keeps only one of the two modes set.
  registrationOpenDayOfWeek Int?
  /// "HH:MM" (Asia/Jerusalem), paired with registrationOpenDayOfWeek
  registrationOpenTime      String?
  title                     String?
  description               String?
  imageUrl                  String?
  isOpenToJoin              Boolean             @default(true)
  isFriendsOnly             Boolean             @default(false)
  /// Same meaning as Game.friendsOnlyLinkPolicy, for the group page and its subscribe button.
  /// Copied to the group's games (generated and propagated on PATCH).
  friendsOnlyLinkPolicy     FriendsOnlyLinkPolicy @default(REQUEST_TO_JOIN)
  joinPolicy                JoinPolicy          @default(INSTANT)
  lotteryEnabled            Boolean             @default(false)
  organizerInLottery        Boolean             @default(false)
  teamSize                  Int?
  welcomeMessage            String?
  /// Members get early registration; non-members (even the organizer's friends) request
  /// membership (SeriesJoinRequest) and register at the guest window.
  membersOnlyPriority       Boolean             @default(false)
  /// Guests may register this many hours before game start (<= the members' lead time).
  guestRegistrationOpenHours Float?
  guestWelcomeMessage       String?
  guestDescription          String?
  /// Display-only ILS amount shown to guests. Not billed in-app.
  guestPrice                Int?
  organizer                 User                @relation("OrganizerSeries", fields: [organizerId], references: [id])
  games                     Game[]
  subscribers               SeriesParticipant[]
  joinRequests              SeriesJoinRequest[]

  @@index([isActive])
  @@index([organizerId])
}

model SeriesParticipant {
  id        String         @id @default(cuid())
  seriesId  String
  userId    String
  role      SeriesRoleType @default(MEMBER)
  createdAt DateTime       @default(now())
  series    GameSeries     @relation(fields: [seriesId], references: [id])
  user      User           @relation(fields: [userId], references: [id])

  @@unique([seriesId, userId])
}

/// A non-friend's pending (or declined) request to join a friends-only group. Kept apart from
/// SeriesParticipant so every subscriber query keeps meaning "real member"; approving creates
/// the SeriesParticipant row and deletes this one.
model SeriesJoinRequest {
  id        String                  @id @default(cuid())
  seriesId  String
  userId    String
  status    SeriesJoinRequestStatus @default(PENDING)
  createdAt DateTime                @default(now())
  series    GameSeries              @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seriesId, userId])
  @@index([seriesId, status])
}

model FlaggedMessage {
  id            String   @id @default(cuid())
  messageId     String?
  content       String
  userId        String
  status        String   @default("PENDING_RETRY")
  resolution    String?
  retryCount    Int      @default(0)
  failureReason String?
  aiTriggers    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, read])
  @@index([createdAt])
  @@index([userId, type, createdAt(sort: Desc)])
}

model UserDevice {
  id            String   @id @default(cuid())
  userId        String
  fcmToken      String?  @unique
  deviceType    String?
  deviceName    String?
  lastUsed      DateTime @default(now())
  createdAt     DateTime @default(now())
  expoPushToken String?  @unique
  user          User     @relation("UserDevices", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fcmToken])
  @@index([expoPushToken])
}

/// Per-user notification preferences. The four original columns keep their meaning for old
/// clients: pushEnabled is the master push switch, and friendRequestsEnabled / messagesEnabled /
/// gameRemindersEnabled are the PUSH flag of their category. See server/utils/notificationPrefs.js.
model UserNotificationSettings {
  id                    String      @id @default(cuid())
  userId                String      @unique
  pushEnabled           Boolean     @default(true)
  friendRequestsEnabled Boolean     @default(true)
  messagesEnabled       Boolean     @default(true)
  gameRemindersEnabled  Boolean     @default(true)
  friendRequestsInApp   Boolean     @default(true)
  gameRemindersInApp    Boolean     @default(true)
  myGamesPush           Boolean     @default(true)
  myGamesInApp          Boolean     @default(true)
  invitationsPush       Boolean     @default(true)
  invitationsInApp      Boolean     @default(true)
  organizerPush         Boolean     @default(true)
  organizerInApp        Boolean     @default(true)
  groupGamesPush        Boolean     @default(true)
  groupGamesInApp       Boolean     @default(true)
  friendGamesPush       Boolean     @default(true)
  friendGamesInApp      Boolean     @default(true)
  friendJoinsPush       Boolean     @default(false)
  friendJoinsInApp      Boolean     @default(false)
  cityGamesPush         Boolean     @default(false)
  cityGamesInApp        Boolean     @default(true)
  /// empty = all sports
  cityGamesSports       SportType[] @default([])
  /// empty = the user's profile city. Stored as canonical city names (shared/cityAliases)
  cityGamesCities       String[]    @default([])
  quietHoursEnabled     Boolean     @default(false)
  /// minutes since local midnight; the window may wrap midnight (start > end)
  quietHoursStart       Int         @default(1380)
  quietHoursEnd         Int         @default(420)
  timezone              String      @default("Asia/Jerusalem")
  /// all push paused until this instant
  snoozeUntil           DateTime?
  /// one-time "turn on city-game push?" suggestion dismissed/answered
  cityPromptDismissedAt DateTime?
  updatedAt             DateTime    @default(now()) @updatedAt
  user                  User        @relation("UserNotificationSettings", fields: [userId], references: [id], onDelete: Cascade)
}

/// Silences notifications originating from a user, a group (series) or a single game.
/// Safety-critical types (cancellation, waitlist offer, join decision, removal) are never muted.
model NotificationMute {
  id         String                 @id @default(cuid())
  userId     String
  targetType NotificationMuteTarget
  targetId   String
  /// null = muted until removed
  until      DateTime?
  createdAt  DateTime               @default(now())
  user       User                   @relation("UserNotificationMutes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model AgentCostLedger {
  costScopeId String   @id
  spentUsd    Float    @default(0)
  updatedAt   DateTime
}

model AgentExecutionLog {
  id           String   @id
  taskId       String
  stepId       String
  agentId      String
  role         String
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([taskId])
}

model AgentTaskState {
  taskId       String   @id
  sessionId    String
  parentTaskId String?
  status       String
  version      Int      @default(1)
  state        Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([parentTaskId])
  @@index([sessionId])
  @@index([status])
}

