// ---------------------------------------------------------------------------
// Match results, player stats and user reports
// (docs/plans/2026-10-feature-match-results.md). No result notification type by design.
// ---------------------------------------------------------------------------

enum GameResultStatus {
  DRAFT
  FINAL
}

enum ResultOutcome {
  WIN
  LOSS
  DRAW
}

/// How the sides of a multi-round evening are formed.
/// FIXED_TEAMS: the game's teams stay; only the pairing changes (winner stays).
/// ROTATING_LINEUPS: each round's sides are player lists, copied from the previous round and edited.
enum ResultLineupMode {
  FIXED_TEAMS
  ROTATING_LINEUPS
}

enum UserReportReason {
  HARASSMENT
  VIOLENCE
  CHEATING
  NO_SHOW
  FAKE_PROFILE
  INAPPROPRIATE_CONTENT
  RESULT_DISPUTE
  OTHER
}

enum UserReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// One recorded result per game. A single score is round 1 with `lineupMode` null.
/// Several rounds are one pickup evening (winner-stays or rotating lineups).
/// Profile stats: the evening counts as one game played; per-round W/D/L is separate.
/// See docs/plans/2026-10-multi-round-results.md.
model GameResult {
  id           String            @id @default(cuid())
  gameId       String            @unique
  sport        SportType
  status       GameResultStatus  @default(FINAL)
  recordedById String
  recordedAt   DateTime          @default(now())
  editedById   String?
  editedAt     DateTime?
  /// recordedAt + 7 days; only admin edits after.
  lockedAt     DateTime?
  notes        String?
  /// Null = one score (legacy and new single-round saves). Set when the evening has a lineup rule.
  lineupMode   ResultLineupMode?
  game         Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  rounds       GameResultRound[]
  sides        GameResultSide[]
}

/// One match inside an evening. Existing results are backfilled as order 1.
model GameResultRound {
  id       String           @id @default(cuid())
  resultId String
  /// 1-based sequence.
  order    Int
  result   GameResult       @relation(fields: [resultId], references: [id], onDelete: Cascade)
  sides    GameResultSide[]

  @@unique([resultId, order])
  @@index([resultId])
}

/// A side = a game Team, or an ad-hoc side (tennis singles / games without Team rows).
model GameResultSide {
  id       String        @id @default(cuid())
  resultId String
  roundId  String
  /// 0 = home/A, 1 = away/B, within the round.
  order    Int
  /// Optional link to Team (no FK: label is the durable snapshot).
  teamId   String?
  /// Snapshot of the team name so later team edits do not rewrite history.
  label    String
  score    Int           @default(0)
  /// Tennis: [[6,4],[3,6]]
  sets     Json?
  outcome  ResultOutcome
  result   GameResult    @relation(fields: [resultId], references: [id], onDelete: Cascade)
  round    GameResultRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  statEntries PlayerStatEntry[]
  players  GameResultRoundPlayer[]

  @@unique([roundId, order])
  @@index([resultId])
}

/// Who played on a side in one round, and how many they scored.
/// Fixed-team evenings store every confirmed player of that team (goals 0 if they did not score).
/// Rotating evenings store the lineup the organizer entered.
model GameResultRoundPlayer {
  id     String         @id @default(cuid())
  sideId String
  userId String
  /// Scoring units this round: soccer goals or basketball points. 0 = played, did not score.
  goals  Int            @default(0)
  side   GameResultSide @relation(fields: [sideId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sideId, userId])
  @@index([userId])
}

/// Per-player stat as key/value rows so new stats need no migration.
model PlayerStatEntry {
  id     String  @id @default(cuid())
  /// Exactly one of gameId / tournamentMatchId is set (raw-SQL CHECK in the migration).
  gameId String?
  tournamentMatchId String?
  userId String
  /// Side the player played for (gives the player's W/D/L).
  sideId String?
  /// Validated against shared/matchStats.js.
  key    String
  value  Int
  game   Game?   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tournamentMatch TournamentMatch? @relation(fields: [tournamentMatchId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  side   GameResultSide? @relation(fields: [sideId], references: [id], onDelete: SetNull)

  @@index([sideId])
  @@unique([gameId, userId, key])
  @@unique([tournamentMatchId, userId, key])
  @@index([tournamentMatchId])
  @@index([userId, key])
  @@index([gameId])
}

model UserReport {
  id           String           @id @default(cuid())
  reporterId   String
  targetId     String
  /// Optional context.
  gameId       String?
  /// Optional tournament context.
  tournamentId String?
  reason       UserReportReason
  details      String?
  status       UserReportStatus @default(OPEN)
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  reporter     User             @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  target       User             @relation("ReportsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  tournament   Tournament?      @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  // One open report per (reporter, target, game) is enforced in code: a NULL gameId does not
  // collide in a Postgres unique index.
  @@index([status, createdAt])
  @@index([targetId])
  @@index([tournamentId])
}

// ---------------------------------------------------------------------------
// Tournaments (docs/plans/2026-10-feature-tournaments.md). Standings are computed, not stored.
// ---------------------------------------------------------------------------

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TournamentFormat {
  LEAGUE
  KNOCKOUT
  GROUPS_KNOCKOUT
  CUSTOM
}

enum TournamentTeamStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
  WITHDRAWN
}

enum TournamentMemberRole {
  CAPTAIN
  PLAYER
  SUBSTITUTE
}

enum TournamentMemberStatus {
  INVITED
  ACCEPTED
  DECLINED
  REMOVED
}

enum TournamentMatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  FORFEIT
  POSTPONED
  CANCELLED
}

enum TournamentStageType {
  GROUP
  LEAGUE
  KNOCKOUT
}

enum TournamentRoleType {
  ORGANIZER
  MANAGER
  SCOREKEEPER
}

model Tournament {
  id                   String            @id @default(cuid())
  organizerId          String
  title                String
  description          String?
  sport                SportType
  imageUrl             String?
  /// Main venue (optional; matches can override).
  fieldId              String?
  customLocation       String?
  startsAt             DateTime
  endsAt               DateTime?
  status               TournamentStatus  @default(DRAFT)
  format               TournamentFormat
  isPublic             Boolean           @default(true)
  openToMinors         Boolean           @default(false)
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  /// After this no roster changes without the organizer.
  rosterLockAt         DateTime?
  minTeams             Int               @default(2)
  maxTeams             Int
  startersPerTeam      Int
  minPlayersPerTeam    Int
  maxPlayersPerTeam    Int
  requireApproval      Boolean           @default(true)
  /// points (3/1/0), tiebreak order, legs, matchDuration, thirdPlace, ...
  rules                Json
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  organizer            User              @relation("TournamentOrganizer", fields: [organizerId], references: [id])
  field                Field?            @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  teams                TournamentTeam[]
  stages               TournamentStage[]
  matches              TournamentMatch[]
  roles                TournamentRole[]
  reports              UserReport[]
  standingsOverrides   TournamentStandingsOverride[]

  @@index([status, startsAt])
  @@index([organizerId])
}

model TournamentTeam {
  id           String                 @id @default(cuid())
  tournamentId String
  name         String
  color        String?
  logoUrl      String?
  captainId    String
  status       TournamentTeamStatus   @default(PENDING)
  seed         Int?
  /// Tie-break pin used only when this table has no TournamentStandingsOverride.
  /// A table override (manual order until reset) wins over these pins.
  manualRank   Int?
  groupId      String?
  /// Invite link code.
  joinCode     String                 @unique
  createdAt    DateTime               @default(now())
  tournament   Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  captain      User                   @relation("TournamentTeamCaptain", fields: [captainId], references: [id])
  group        TournamentGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  members      TournamentTeamMember[]
  homeMatches  TournamentMatch[]      @relation("TournamentMatchHome")
  awayMatches  TournamentMatch[]      @relation("TournamentMatchAway")
  standingsAdjustments TournamentStandingsAdjustment[]

  @@unique([tournamentId, name])
  @@index([tournamentId, status])
}

model TournamentTeamMember {
  id           String                 @id @default(cuid())
  teamId       String
  /// Denormalised: at most one ACCEPTED team per player per tournament (partial unique index in
  /// migration 20261021140000, which Prisma cannot express).
  tournamentId String
  userId       String
  role         TournamentMemberRole   @default(PLAYER)
  status       TournamentMemberStatus @default(INVITED)
  jerseyNumber Int?
  createdAt    DateTime               @default(now())
  team         TournamentTeam         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tournamentId, userId])
  @@index([teamId])
  @@index([userId])
}

model TournamentStage {
  id           String              @id @default(cuid())
  tournamentId String
  order        Int
  type         TournamentStageType
  name         String
  /// groups count, legs, advance count, seeding method.
  config       Json
  tournament   Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groups       TournamentGroup[]
  matches      TournamentMatch[]
  standingsOverrides TournamentStandingsOverride[]

  @@unique([tournamentId, order])
}

model TournamentGroup {
  id      String            @id @default(cuid())
  stageId String
  name    String
  stage   TournamentStage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  teams   TournamentTeam[]
  matches TournamentMatch[]
  standingsOverrides TournamentStandingsOverride[]

  @@index([stageId])
}

model TournamentMatch {
  id            String                @id @default(cuid())
  tournamentId  String
  stageId       String
  groupId       String?
  round         Int
  /// Display number within the tournament.
  number        Int
  homeTeamId    String?
  awayTeamId    String?
  /// {type:'WINNER_OF',matchId} | {type:'GROUP_RANK',groupId,pos} | {type:'SEED',n}
  homeSource    Json?
  awaySource    Json?
  scheduledAt   DateTime?
  fieldId       String?
  courtLabel    String?
  status        TournamentMatchStatus @default(SCHEDULED)
  homeScore     Int?
  awayScore     Int?
  homePenalties Int?
  awayPenalties Int?
  /// Tennis sets.
  details       Json?
  winnerTeamId  String?
  /// Optimistic concurrency for score updates.
  version       Int                   @default(0)
  updatedById   String?
  tournament    Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stage         TournamentStage       @relation(fields: [stageId], references: [id], onDelete: Cascade)
  group         TournamentGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  homeTeam      TournamentTeam?       @relation("TournamentMatchHome", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeam      TournamentTeam?       @relation("TournamentMatchAway", fields: [awayTeamId], references: [id], onDelete: SetNull)
  statEntries   PlayerStatEntry[]

  @@index([tournamentId, stageId, round])
  @@index([tournamentId, scheduledAt])
}

/// Manual order for one group or league table. Absent means the table is fully automatic.
/// While the row exists, viewers see `teamOrder` (teams missing from it append in automatic
/// order) until a manager deletes it. Match results keep updating automatic stats.
/// `points` on TournamentStandingsAdjustment are added to those automatic points and do not
/// re-sort the table. Per-team TournamentTeam.manualRank pins are ignored while this row exists.
/// `tableKey` is `stageId` for a league table and `stageId:groupId` for a group, so a null
/// groupId cannot collide under Postgres unique-null rules.
model TournamentStandingsOverride {
  id           String   @id @default(cuid())
  tournamentId String
  stageId      String
  groupId      String?
  tableKey     String   @unique
  /// Best-first team ids.
  teamOrder    String[]
  createdById  String
  updatedById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tournament   Tournament                        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stage        TournamentStage                   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  group        TournamentGroup?                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy    User                              @relation("StandingsOverrideCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User                              @relation("StandingsOverrideUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  adjustments  TournamentStandingsAdjustment[]

  @@index([tournamentId])
}

/// Signed points added to one team's automatic total for the parent override. Never zero.
model TournamentStandingsAdjustment {
  id         String                       @id @default(cuid())
  overrideId String
  teamId     String
  points     Int
  reason     String
  override   TournamentStandingsOverride  @relation(fields: [overrideId], references: [id], onDelete: Cascade)
  team       TournamentTeam               @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([overrideId, teamId])
  @@index([teamId])
}

model TournamentRole {
  id           String             @id @default(cuid())
  tournamentId String
  userId       String
  role         TournamentRoleType
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}
