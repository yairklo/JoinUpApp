# Names only. Put real values in Coolify / your local shell, never in git.
# Dev uses a new empty Neon project (not a branch of production) and Clerk test
# keys (sk_test_ / pk_test_). Schema comes from `prisma migrate deploy` on boot.
# Data comes from `npm run seed:dev` (PR #374), never from a production copy.
# Production keeps its own database and pk_live_ / sk_live_. Never copy those here.

# --- Database (Neon). DATABASE_URL is pooled. DIRECT_DATABASE_URL is NOT the pooler host. ---
# Dev: the empty joinup-dev project. Do not paste the production host.
DATABASE_URL=
DIRECT_DATABASE_URL=

# --- Auth (Clerk). Dev resource: sk_test_ and pk_test_ only. ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# --- CORS / URLs ---
# Comma-separated web origins. Vercel previews of this project are already allowed by code.
# Add a custom dev web domain if you have one. Do not set CORS_PERMISSIVE.
CORS_ORIGINS=
# Dev API public URL, e.g. https://joinup-dev-api.duckdns.org
PUBLIC_SERVER_URL=

# --- Uploads. Required when NODE_ENV=production (the server refuses to boot without it). ---
# Use a dev folder so a delete cannot touch production images.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=joinup-dev

# --- Optional ---
# REDIS_URL=            # leave unset, or a Redis that production does not use.
#                       # Never the production URL: socket/scheduler pub/sub
#                       # (joinup:socket_events, joinup:scheduler_events) would cross envs.
# RUN_BACKGROUND_JOBS=false
#                       # Unset means jobs ON. Keep false until the database is the
#                       # empty schema plus seed:dev, with no production UserDevice tokens.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ADMIN_USER_IDS=
# JWT_SECRET=
# FIREBASE_PROJECT_ID=  # do not paste production Firebase credentials on dev
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# AGE_GATE_ENFORCED=

# Seed guard (local shell only, when running server/scripts/seedDev.js):
# JOINUP_SEED_CONFIRM=dev
# PROD_DATABASE_URL=   # optional blocklist; seed refuses if DATABASE_URL equals this
