{
	email {$ACME_EMAIL}

	servers {
		timeouts {
			# Slow-loris protection; no read_body/write timeout so WebSockets and uploads are not cut.
			read_header 10s
			idle 5m
		}
	}
}

# ---- API + Socket.IO (server, port 3005, Socket.IO path /api/socket) ----
# The web app is NOT served from here (it is hosted on Vercel).
{$API_DOMAIN} {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
	}

	# Caddy proxies WebSocket upgrades transparently, so Socket.IO needs no extra config.
	# flush_interval -1 disables buffering (long-polling fallback, streamed responses).
	# Caddy sets X-Forwarded-For/-Proto/-Host; the app uses `trust proxy` = 1, so exactly ONE
	# proxy hop (this one) is expected. If Cloudflare is in front, see the runbook.
	reverse_proxy api:3005 {
		flush_interval -1
		health_uri /api/health
		health_interval 15s
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
	}

	# MULTIPLE API SERVERS (when api1/api2 exist; needs PR #370 for cross-instance realtime):
	# replace the reverse_proxy above with e.g.
	#   reverse_proxy api1:3005 api2:3005 {
	#       lb_policy cookie          # sticky sessions: Socket.IO long-polling needs them
	#       lb_try_duration 5s        # retry another upstream on failure
	#       lb_try_interval 250ms
	#       fail_duration 30s
	#       health_uri /api/health
	#       health_interval 10s
	#       health_timeout 3s
	#       flush_interval -1
	#   }

	# Largest legitimate body: one image upload, capped at 5 MB in shared/upload.js (MAX_IMAGE_FILE_SIZE)
	# plus multipart overhead. JSON bodies are far smaller (express.json default 100 kb).
	request_body {
		max_size 8MB
	}
}
