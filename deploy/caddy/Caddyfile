{
	email {$ACME_EMAIL}
}

# Shared snippet: compression + baseline headers. Next.js already sets CSP/HSTS etc. for the web
# app (next_app/next.config.ts), so we only harden what the API does not set itself.
(common) {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
	}
}

# ---- API + Socket.IO (server, port 3005, Socket.IO path /api/socket) ----
{$API_DOMAIN} {
	import common
	header Strict-Transport-Security "max-age=63072000; includeSubDomains"

	# Caddy proxies WebSocket upgrades transparently, so Socket.IO needs no extra config.
	# flush_interval -1 disables buffering (long-polling fallback, streamed responses).
	# Caddy sets X-Forwarded-For/-Proto/-Host; the app uses `trust proxy` = 1, so exactly ONE
	# proxy hop (this one) is expected. If Cloudflare is in front, see the runbook.
	reverse_proxy api:3005 {
		flush_interval -1
		health_uri /api/health
		health_interval 15s
	}

	# MULTIPLE API SERVERS (when api1/api2 exist): replace the reverse_proxy above with e.g.
	#   reverse_proxy api1:3005 api2:3005 {
	#       lb_policy cookie          # sticky sessions: Socket.IO long-polling needs them
	#       lb_try_duration 5s        # retry another upstream on failure
	#       lb_try_interval 250ms
	#       fail_duration 30s
	#       health_uri /api/health
	#       health_interval 10s
	#       health_timeout 3s
	#       flush_interval -1
	#   }

	request_body {
		max_size 25MB
	}
}

# ---- Web app (Next.js, port 3000) - only used when the `web` compose profile is enabled ----
# If the web app is hosted elsewhere (Vercel etc.), delete this block.
{$WEB_DOMAIN} {
	import common
	reverse_proxy web:3000
}
