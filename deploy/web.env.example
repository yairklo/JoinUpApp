# Web runtime (server-side) env -> copy to deploy/web.env. Only for the `web` profile.
# NEXT_PUBLIC_* are build args in .env, not here.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
