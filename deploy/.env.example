# Compose-level settings (read by `docker compose` from deploy/.env). No secrets here.
# Copy to deploy/.env and fill in. Do not put trailing comments on value lines.

# Public hostnames (DNS must point at this server before first start).
# ASSUMPTION: joinup-api.duckdns.org comes from next_app/src/lib/csp.test.ts - confirm.
API_DOMAIN=joinup-api.duckdns.org
ACME_EMAIL=you@example.com

# Redis password (long random string; use A-Za-z0-9 so it needs no URL-encoding).
REDIS_PASSWORD=change-me

# Optional services, comma separated: worker. Empty = api + redis + caddy only.
COMPOSE_PROFILES=
# Required (true) when COMPOSE_PROFILES includes worker: set to false so jobs run only in the worker.
API_RUN_BACKGROUND_JOBS=true

# Makes plain `docker compose ...` commands in deploy/ use the same files as deploy.sh.
# (Use ';' instead of ':' as separator if you ever run this on Windows.)
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Resource limits (see docker-compose.prod.yml). Keep API_CPUS <= your vCPU count.
API_CPUS=1
API_MEM_LIMIT=768m
WORKER_MEM_LIMIT=384m

# IMAGE_TAG is set by deploy.sh (git short SHA). Do not set by hand.

# NOTE: Compose interpolates ' in this file and in api.env: write a literal ' as '$'.
# Prefer URL-safe passwords (A-Za-z0-9) to avoid the problem altogether.
