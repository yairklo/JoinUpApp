# Compose-level settings (read by `docker compose` from deploy/.env). No secrets here.
# Copy to deploy/.env and fill in. Do not put trailing comments on value lines.

# Public hostnames (DNS must point at this server before first start).
# ASSUMPTION: joinup-api.duckdns.org comes from next_app/src/lib/csp.test.ts - confirm.
API_DOMAIN=joinup-api.duckdns.org
ACME_EMAIL=you@example.com
# Only needed with the web profile:
WEB_DOMAIN=

# Optional services, comma separated: web, worker. Empty = api + redis + caddy only.
COMPOSE_PROFILES=

# IMAGE_TAG is set by deploy.sh (git short SHA). Do not set by hand.

# ---- Web build args (web profile only). Public values, inlined at build time. ----
NEXT_PUBLIC_API_URL=https://joinup-api.duckdns.org
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
