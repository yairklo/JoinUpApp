# API runtime env -> copy to deploy/api.env. Names come from process.env usage in server/.
# NEVER commit real values. NODE_ENV, PORT and REDIS_URL are set by docker-compose.yml.
# Compose env_file does not strip trailing comments: keep comments on their own lines.

# --- Database (Postgres; prisma/schema.prisma uses both) ---
# DATABASE_URL: pooled connection string (runtime). DIRECT_DATABASE_URL: direct string for migrations.
DATABASE_URL=
DIRECT_DATABASE_URL=

# --- Auth (Clerk) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
JWT_SECRET=
# Comma separated Clerk user ids
ADMIN_USER_IDS=

# --- CORS / URLs ---
# Comma separated allowed web origins, e.g. https://your-web-domain
CORS_ORIGINS=
# Leave unset in production
# CORS_PERMISSIVE=
# Public API base URL
PUBLIC_SERVER_URL=https://joinup-api.duckdns.org
# Set true only if Cloudflare proxies the API domain
# TRUST_CF_CONNECTING_IP=

# --- Uploads (required in production; server refuses to boot without it) ---
CLOUDINARY_URL=
CLOUDINARY_FOLDER=
# ALLOW_DISK_UPLOADS=true is not recommended: container disk is lost on redeploy

# --- Push notifications (Firebase): EITHER the three vars OR a mounted service-account file ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_PATH=

# --- AI features ---
OPENAI_API_KEY=
GOOGLE_API_KEY=
# AI_RATE_LIMIT=
# DEBUG_AI=

# --- Monitoring ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=

# --- Behaviour switches ---
# AGE_GATE_ENFORCED=
# false when a dedicated worker container runs the jobs (default true)
# RUN_BACKGROUND_JOBS=
